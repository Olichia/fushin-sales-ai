GEMINI_API_KEY=your_gemini_api_key

# Supabase Postgres 連線字串：用 Transaction pooler (port 6543)，不要用 Direct connection (port 5432)
# Project Settings -> Database -> Connect -> Connection Method -> 選 "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxxxxxx:your_password@aws-0-xxxxx.pooler.supabase.com:6543/postgres